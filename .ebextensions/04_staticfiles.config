commands:
  create_static_dir:
    command: "mkdir -p /var/app/staging/static/"

files:
  "/etc/httpd/conf.d/static.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      Alias /static/ /var/app/staging/static/
      <Directory /var/app/staging/static/>
          Require all granted
      </Directory>
